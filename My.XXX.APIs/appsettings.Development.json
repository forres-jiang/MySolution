{
  "AppConfig": {
    "PermissionDataCache": 0
  },
  "RedisConfig": {
    "ConnectionString": ""
  },
  "AllowedHosts": "*",
  "JwtConfig": {
    "Secret": "",
    "Issuer": "My.XXX.API",
    "Audience": "XXX",
    "ExpiryInMinutes": 20,
    "RefreshExpiryInMinutes": 43200
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "AllowedHostArray": [
    "http://localhost:8080",
    "http://localhost:8081",
    "http://localhost:9000"
  ],
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": { "Default": "Debug" },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "RestrictedToMinimumLevel": "Warning",
          "retainedFileCountLimit": "90"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "xxx"
    }
  }
}