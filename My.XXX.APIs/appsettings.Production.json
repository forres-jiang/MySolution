{
  "AppConfig": {
    "PermissionDataCache": 0 /*1:Redis,0:DB*/
  },
  "PermissionWhitelist": {
    "Codes": []
  },
  "RedisConfig": {
    /*Rancher内部调用Redis的地址和端口 fcs-redis-service.commoncache.svc.cluster.local:6379*/
    "ConnectionString": ""
  },
  "AllowedHosts": "*",
  "JwtConfig": {
    "Secret": "",
    "Issuer": "My.XXX.API",
    "Audience": "XXX",
    "ExpiryInMinutes": 20, /*token过期时间*/
    "RefreshExpiryInMinutes": 43200
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "AllowedHostArray": [
    "http://localhost:8080",
    "http://localhost:8081",
    "http://localhost:9000",
    "http://localhost:9001",
    "http://localhost:9002"
  ],
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/.txt",
          "rollingInterval": "Day",
          "RestrictedToMinimumLevel": "Warning",
          "retainedFileCountLimit": "90"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "xxx"
    }
  }
}