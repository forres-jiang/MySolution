<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aspire AppHost SDK：负责编排资源、启动 Dashboard、注入连接串到被编排的项目 -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.2" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>My.XXX.AppHost</RootNamespace>
    <AssemblyName>My.XXX.AppHost</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 标记为 Aspire Host 项目，触发 Dashboard 自动接线 -->
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>7f3c1a92-4b8e-4d5f-9a6c-2e1b0d3f4a5b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppHost 只做编排引用，不会将 API 项目打包进 AppHost 产物 -->
    <ProjectReference Include="..\My.XXX.APIs\01My.XXX.APIs.csproj" />
  </ItemGroup>

</Project>
